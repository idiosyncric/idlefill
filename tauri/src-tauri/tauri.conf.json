{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Idlefill",
  "version": "1.0.0",
  "identifier": "com.sam.idlefill.app",
  "build": {
    "frontendDist": "../settings-ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["idlefill"]
      }
    }
  }
}
