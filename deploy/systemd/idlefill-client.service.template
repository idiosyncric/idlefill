# idlefill client — Linux systemd unit template (issue #54)
#
# Mirrors deploy/com.sam.idlefill.client.plist semantics:
#   KeepAlive{SuccessfulExit=false}  ->  Restart=on-failure
#       (a crash or signal death restarts; a clean exit(0) does not)
#   ThrottleInterval=30              ->  RestartSec=30
#   RunAtLoad                        ->  WantedBy=default.target (on login)
#   launchd logs to files            ->  journald (`journalctl --user -u idlefill-client`)
#
# USER UNIT (default): runs as the logged-in user, no sudo, with
# `loginctl enable-linger <user>` so it starts at boot and survives logout
# (the launchd LaunchAgent analogue). The installer renders this file to
# ~/.config/systemd/user/idlefill-client.service.
#
# Placeholders (the installer substitutes; never ship @-tokens live):
#   @REPO@   absolute repo checkout path
#   @NPATH@  bin dir holding node/npx (from `command -v npx`)
#
# The daemon runs from the working tree exactly like the macOS launchd
# agent: tsx client/src/index.ts. That is also what makes issue #49's
# code-staleness flag work here — the boot `revision` is `git rev-parse
# HEAD` in the checkout, so pull + `systemctl --user restart` updates it.
#
# A SYSTEM unit variant is deliberately NOT shipped: it needs root, a
# dedicated service user, and re-derives every path; the user unit covers
# the vision (per-owner machines, per-user checkout) without sudo. If a
# headless shared box ever needs the system flavor, copy this file to
# /etc/systemd/system/ without the --user flags and set User= — but do
# not install it from the repo's installer (it refuses).

[Unit]
Description=idlefill client daemon (worker + session gate + loopback router)
Documentation=https://git.samwarth.com/sam/idlefill
# No network targets: network-online.target is a SYSTEM target and does not
# exist in the user manager. The daemon already tolerates an unreachable
# arbiter (retry loop + fail-open gate), so ordering against the network is
# both impossible here and unnecessary.

[Service]
Type=simple
WorkingDirectory=@REPO@/client
ExecStart=@NPATH@/npx tsx @REPO@/client/src/index.ts
Environment=PATH=@NPATH@:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=30
# Keep stdout out of the pty-less default; journald captures either way.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=idlefill-client

[Install]
WantedBy=default.target
