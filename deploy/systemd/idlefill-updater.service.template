# idlefill host updater helper — Linux systemd USER unit template (mesh-update.md D3)
#
# The per-machine helper that CLAIMS update intents from the local arbiter
# and runs the machine's own documented update command. The arbiter executes
# nothing; this unit is the machine's consent to update itself. No unit = an
# intent answers `queued` and goes `stale` at the TTL — the dashboard says
# exactly that, never a fake progress.
#
# Same discipline as idlefill-client.service.template: USER unit + linger,
# Restart=on-failure, journald logs, rendered (never shipped live) by
# deploy/install-updater-service.sh.
#
# Placeholders (the installer substitutes):
#   @REPO@   absolute repo checkout path (the one this helper runs from)
#   @NPATH@  bin dir holding node
#   @CFG@    the helper's 0600 config path (default ~/.idlefill/updater.json)

[Unit]
Description=idlefill host updater helper (claims update intents, runs this machine's update command)
Documentation=https://git.samwarth.com/sam/idlefill

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=@NPATH@/node @REPO@/scripts/host-updater.mjs
Environment=PATH=@NPATH@:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=IDLEFILL_UPDATER_CONFIG=@CFG@
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=idlefill-updater

[Install]
WantedBy=default.target
