# idlefill arbiter (server) — Linux systemd unit template (the urza native cutover, 2026-10-13)
#
# The Linux counterpart of the macOS LaunchAgent deploy/com.sam.idlefill.server.plist
# (issue #60 Slice A's fused Mac instance), same shape as
# idlefill-client.service.template: the arbiter runs from the WORKING TREE
# with tsx, so `git pull` + `systemctl --user restart` IS the update (the
# build-gap counter reads this checkout's HEAD, so the boot revision is
# honest without a build step).
#
# This is the NATIVE arbiter: the machine's one fused process owner. The
# container-era path (scripts/deploy-server.sh + scripts/urza-selfupdate.sh)
# built an image and swapped a host-networked container; here the arbiter is
# an ordinary host process, which is what gives its own client daemon the
# Docker vantage (docs/architecture/container-ops.md D1) and the operator's
# `idlefill engine add --local` the co-location the mesh rule 1 demands.
#
# USER UNIT (rendered by deploy/install-server-service.sh into
# ~/.config/systemd/user/idlefill-server.service; linger makes it boot
# without a login). No SYSTEM variant, same reasoning as the client unit.
#
# Placeholders (the installer substitutes; never ship @-tokens live):
#   @REPO@   absolute repo checkout path
#   @NPATH@  bin dir holding node/npx (from `command -v npx`)
#   @STATE@  absolute state.json path (carried across the cutover, so the
#            instance id, the pairing edges and the lease history survive)
#
# Secrets never live in this file: the arbiter reads its own
# server/config.json (0600, gitignored) from next to the entry point, exactly
# like the container read /app/config.json.

[Unit]
Description=idlefill arbiter (tick loop + HTTP + WS + dashboard) — native host install
Documentation=https://git.samwarth.com/sam/idlefill

[Service]
Type=simple
WorkingDirectory=@REPO@/server
ExecStart=@NPATH@/npx tsx @REPO@/server/src/index.ts
Environment=PATH=@NPATH@:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=IDLEFILL_STATE=@STATE@
# Always, not on-failure: this process replaces the container's
# `--restart unless-stopped`. An unexpected clean exit still must not leave
# the machine without its arbiter; an operator `systemctl --user stop` is
# never auto-restarted by systemd regardless of this key.
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=idlefill-server

[Install]
WantedBy=default.target
