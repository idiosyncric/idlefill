{
  "name": "idlefill",
  "private": true,
  "version": "2",
  "description": "Run background AI work on the local LLM server only when it has been idle.",
  "type": "module",
  "workspaces": [
    "server",
    "client",
    "adapters/career-ops",
    "adapters/noop",
    "tauri/ui",
    "dashboard",
    "fleet"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
